@startuml CL_Rules
' requirement REQ-00007-2
' requirement REQ-00008-1
' requirement REQ-00011-1
' requirement REQ-00012-1

!startsub RulesModule

namespace plantuml_fmt.rules {
  class rewrite_relation <<function>> {
    + rewrite_relation(src: bytes, node: Node) : bytes | None
  }
  class rewrite_member <<function>> {
    + rewrite_member(src: bytes, node: Node, member_style: str) : bytes | None
  }
  class get_parser <<function>> {
    + get_parser() : Parser
  }
  class _converts_faithfully <<function>> {
    - _converts_faithfully(candidate: bytes, want: tuple) : bool
  }
  class _emit_method <<function>> {
    - _emit_method(sig: dict) : bytes
  }
  class _method_signature <<function>> {
    - _method_signature(src: bytes, node: Node) : dict | None
  }
  class _rewrite_attribute <<function>> {
    - _rewrite_attribute(src: bytes, node: Node) : bytes | None
  }
  class _rewrite_method <<function>> {
    - _rewrite_method(src: bytes, node: Node, member_style: str) : bytes | None
  }
  class _signature_key <<function>> {
    - _signature_key(sig: dict) : tuple
  }
  class _single_line <<function>> {
    - _single_line(node: Node) : bool
  }
  class _text <<function>> {
    - _text(src: bytes, node: Node) : bytes
  }
}

!endsub

@enduml
