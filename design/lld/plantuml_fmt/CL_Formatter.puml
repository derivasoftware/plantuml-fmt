@startuml CL_Formatter
' requirement REQ-00001-1
' requirement REQ-00002-1
' requirement REQ-00003-4
' requirement REQ-00004-1
' requirement REQ-00009-1
' requirement REQ-00010-1

!startsub FormatterModule

namespace plantuml_fmt.formatter {
  class "<<module>>" as FormatterModule {
    + format_bytes(src: bytes) : bytes
    + format_text(src: str) : str
    - _get_parser() : Parser
    - _freeze(frozen: list[bool], first_row: int, last_row: int) : None
    - _child_row(node: Node, child_type: str) : int | None
    - _indent_block(node: Node, depth: list[int]) : None
    - _mark_block_edges(node: Node, openers: set[int], closers: set[int]) : None
    - _mark_frame_edges(node: Node, openers: set[int], closers: set[int]) : None
    - _collect(node: Node, depth: list[int], frozen: list[bool], rewrites: dict[int, Node], openers: set[int], closers: set[int]) : None
    - _indent_frame(node: Node, depth: list[int]) : None
    - _is_soft_blank(lines: list[bytes], frozen: list[bool], row: int) : bool
    - _neighbor(row: int, step: int, lines: list[bytes], frozen: list[bool]) : int
    - _keep_blank(row: int, lines: list[bytes], frozen: list[bool], openers: set[int], closers: set[int]) : bool
    - _rewrite(node: Node, src: bytes) : bytes | None
  }
  FormatterModule ..> plantuml_fmt.rules.RulesModule
}

!endsub

@enduml
